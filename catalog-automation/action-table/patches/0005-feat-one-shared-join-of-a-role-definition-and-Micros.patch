+Describe 'Get-RoleContext' {
+    BeforeAll {
+        $script:ctxScript = Join-Path $script:repoRoot 'catalog-automation/Get-RoleContext.ps1'
+        $script:ctxSnap = Join-Path $TestDrive 'ctx-snap'
+        $owner = [pscustomobject]@{ allowedResourceActions = @('microsoft.directory/applications/credentials/update'); condition = '$SubjectIsOwner' }
+        $priv = New-RoleDef 'bbbbbbbb-0000-0000-0000-000000000001' 'Priv' -Actions @('microsoft.directory/users/password/update', 'microsoft.office365.supportTickets/allEntities/allTasks') -Privileged $true
+        $plain = New-RoleDef 'bbbbbbbb-0000-0000-0000-000000000002' 'Plain' -Actions @('microsoft.directory/users/standard/read')
+        $plain | Add-Member -NotePropertyName inheritsPermissionsFrom -NotePropertyValue @([pscustomobject]@{ id = 'bbbbbbbb-0000-0000-0000-000000000001' })
+        $noFlag = New-RoleDef 'bbbbbbbb-0000-0000-0000-000000000003' 'NoFlag' -Actions @('microsoft.directory/users/password/update')
+        $flagOnly = New-RoleDef 'bbbbbbbb-0000-0000-0000-000000000004' 'FlagOnly' -Actions @('microsoft.directory/users/standard/read') -Privileged $true
+        $ownerRole = New-RoleDef 'bbbbbbbb-0000-0000-0000-000000000005' 'Owner' -Actions @('microsoft.directory/users/standard/read') -Privileged $true
+        $ownerRole.rolePermissions = @($ownerRole.rolePermissions) + $owner
+        $unknown = New-RoleDef 'bbbbbbbb-0000-0000-0000-000000000006' 'Unknown' -Actions @('microsoft.directory/brandNew/allTasks')
+        Write-Snapshot $script:ctxSnap @($priv, $plain, $noFlag, $flagOnly, $ownerRole, $unknown)
+        $script:ctxActions = Join-Path $TestDrive 'ctx-actions'
+        $fetch = {
+            param($ns)
+            switch ($ns) {
+                'microsoft.directory' { @(
+                        [pscustomobject]@{ name = 'microsoft.directory/users/standard/read'; description = 'Read users'; isPrivileged = $false },
+                        [pscustomobject]@{ name = 'microsoft.directory/users/password/update'; description = 'Reset passwords'; isPrivileged = $true },
+                        [pscustomobject]@{ name = 'microsoft.directory/applications/credentials/update'; description = 'Update app credentials'; isPrivileged = $true }) }
+                'microsoft.office365.supportTickets' { @([pscustomobject]@{ name = 'microsoft.office365.supportTickets/allEntities/allTasks'; description = 'Manage tickets'; isPrivileged = $false }) }
+            }
+        }
+        & (Join-Path $script:repoRoot 'catalog-automation/Export-ResourceActions.ps1') -RoleDefinitionsDir $script:ctxSnap -OutputPath $script:ctxActions -Fetch $fetch | Out-Null
+        $script:ctx = @{}
+        foreach ($c in @(& $script:ctxScript -RoleDefinitionsDir $script:ctxSnap -ResourceActionsDir $script:ctxActions)) { $script:ctx[$c.displayName] = $c }
+    }
+
+    It 'names the actions that make a privileged role privileged, and calls it consistent' {
+        $c = $script:ctx['Priv']
+        @($c.privilegedBecause.action) | Should -Be @('microsoft.directory/users/password/update')
+        $c.privilegeCheck.status | Should -Be 'consistent'
+    }
+
+    It 'keeps the condition of a sensitive action, so an owner-only cause is visible' {
+        $c = $script:ctx['Owner']
+        ($c.privilegedBecause | Where-Object action -like '*credentials*').condition | Should -Be '$SubjectIsOwner'
+        $c.privilegeCheck.status | Should -Be 'consistent'
+    }
+
+    It 'flags a role whose flag and actions disagree, in both directions' {
+        $script:ctx['FlagOnly'].privilegeCheck.status | Should -Be 'role-flag-without-sensitive-action'
+        $script:ctx['NoFlag'].privilegeCheck.status | Should -Be 'sensitive-action-without-role-flag'
+    }
+
+    It 'says unknown, not consistent, when a directory action has no data' {
+        $c = $script:ctx['Unknown']
+        $c.privilegeCheck.status | Should -Be 'unknown'
+        @($c.undescribedActions) | Should -Be @('microsoft.directory/brandNew/allTasks')
+        ($c.permissions[0].actions[0]).described | Should -BeFalse
+    }
+
+    It 'leaves isPrivileged null outside microsoft.directory and keeps the description' {
+        $a = @($script:ctx['Priv'].permissions.actions) | Where-Object namespace -eq 'microsoft.office365.supportTickets'
+        $a.description | Should -Be 'Manage tickets'
+        $a.isPrivileged | Should -BeNullOrEmpty
+    }
+
+    It 'resolves inherited roles by name, with their sensitive actions' {
+        $i = @($script:ctx['Plain'].inheritsFrom)[0]
+        $i.displayName | Should -Be 'Priv'
+        @($i.sensitiveActions.action) | Should -Be @('microsoft.directory/users/password/update')
+    }
+
+    It 'says unknown for every role without resource-action data, and keeps the definition unchanged' {
+        $c = @(& $script:ctxScript -RoleDefinitionsDir $script:ctxSnap -TemplateId 'bbbbbbbb-0000-0000-0000-000000000001')[0]
+        $c.privilegeCheck.status | Should -Be 'unknown'
+        $c.resourceActions.directoryStatus | Should -Be 'missing'
+        ($c.definition | ConvertTo-Json -Depth 10) | Should -Be ((Get-Content -Raw (Join-Path $script:ctxSnap 'bbbbbbbb-0000-0000-0000-000000000001.json') | ConvertFrom-Json) | ConvertTo-Json -Depth 10)
+    }
+}
