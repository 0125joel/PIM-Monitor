@@ -0,0 +1,162 @@
+#requires -Version 7.0
+<#
+.SYNOPSIS
+    Joins a role definition with Microsoft's per-action information: what each action does, and which
+    actions make the role privileged.
+
+.DESCRIPTION
+    The one place where role-definitions/ and resource-actions/ meet. The review routine and the
+    backtest both use it, so the backtest measures the routine on exactly the input it gets in
+    production. Nothing is written to the snapshot: the definition files stay as Microsoft delivers
+    them, and resource-actions/ stays one file per namespace. The link is the action name, which is in
+    both; the part before the first '/' names the namespace file.
+
+    Per role:
+      definition          the definition file, unchanged
+      permissions         per rolePermissions block: its condition, and per action the namespace,
+                          Microsoft's description and isPrivileged (null outside microsoft.directory,
+                          where Microsoft does not apply the flag), and whether a description was found
+      privilegedBecause   the role's own actions Microsoft flags as sensitive, with their condition:
+                          the reason the role is privileged
+      privilegeCheck      does the role's isPrivileged agree with its actions? Microsoft: "a role is
+                          privileged if it contains at least one sensitive resource action ... applies
+                          only to the microsoft.directory namespace".
+                            consistent                               they agree
+                            role-flag-without-sensitive-action       flag true, no flagged action
+                            sensitive-action-without-role-flag       a flagged action, flag false
+                            unknown                                  cannot tell (no data for
+                                                                     microsoft.directory, or directory
+                                                                     actions without a description)
+      inheritsFrom        the roles it inherits from, with name, and their actions flagged sensitive
+      undescribedActions  actions with no description, listed rather than silently left out
+
+.PARAMETER RoleDefinitionsDir
+    role-definitions/ of a snapshot.
+
+.PARAMETER ResourceActionsDir
+    resource-actions/ of the same snapshot. Optional: without it every action is undescribed and
+    privilegeCheck is unknown.
+
+.PARAMETER TemplateId
+    The roles to return. Default: every role in RoleDefinitionsDir.
+#>
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)] [string] $RoleDefinitionsDir,
+    [Parameter()] [string] $ResourceActionsDir,
+    [Parameter()] [string[]] $TemplateId
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+$directoryNs = 'microsoft.directory'
+
+$roles = @{}
+foreach ($f in Get-ChildItem -Path $RoleDefinitionsDir -Filter '*.json' -File) {
+    $r = Get-Content -Raw -Path $f.FullName | ConvertFrom-Json
+    $roles[([string]$r.templateId).ToLowerInvariant()] = $r
+}
+
+# Action details by lower-case name, and the status of each namespace.
+$details = @{}
+$nsStatus = @{}
+if ($ResourceActionsDir -and (Test-Path $ResourceActionsDir -PathType Container)) {
+    $indexFile = Join-Path $ResourceActionsDir 'index.json'
+    if (Test-Path $indexFile) {
+        $index = Get-Content -Raw -Path $indexFile | ConvertFrom-Json
+        foreach ($p in @($index.PSObject.Properties['namespaces']?.Value.PSObject.Properties)) { $nsStatus[$p.Name] = [string]$p.Value.status }
+    }
+    foreach ($f in Get-ChildItem -Path $ResourceActionsDir -Filter '*.json' -File | Where-Object Name -ne 'index.json') {
+        $doc = Get-Content -Raw -Path $f.FullName | ConvertFrom-Json
+        if (-not $nsStatus.ContainsKey($f.BaseName)) { $nsStatus[$f.BaseName] = 'ok' }
+        foreach ($a in @($doc.actions)) { $details[([string]$a.name).ToLowerInvariant()] = $a }
+    }
+}
+$directoryAvailable = $nsStatus.ContainsKey($directoryNs) -and (Test-Path (Join-Path ($ResourceActionsDir ?? '.') "$directoryNs.json"))
+
+function Get-Namespace { param([string] $Action) ($Action -split '/', 2)[0] }
+
+function Get-SensitiveActions {
+    # The role's own actions that Microsoft flags as sensitive, with the condition of their block.
+    param($Role)
+    foreach ($perm in @($Role.PSObject.Properties['rolePermissions']?.Value)) {
+        if ($null -eq $perm) { continue }
+        $cond = $perm.PSObject.Properties['condition']?.Value
+        foreach ($a in @($perm.PSObject.Properties['allowedResourceActions']?.Value)) {
+            if (-not $a) { continue }
+            $d = $details[([string]$a).ToLowerInvariant()]
+            if ($d -and $d.isPrivileged -eq $true) { [ordered]@{ action = [string]$a; condition = if ($cond) { [string]$cond } else { $null } } }
+        }
+    }
+}
+
+$ids = if ($TemplateId) { @($TemplateId | ForEach-Object { $_.ToLowerInvariant() }) } else { @($roles.Keys | Sort-Object) }
+foreach ($id in $ids) {
+    if (-not $roles.ContainsKey($id)) { throw "No role definition for $id in $RoleDefinitionsDir." }
+    $role = $roles[$id]
+
+    $undescribed = [System.Collections.Generic.List[string]]::new()
+    $undescribedDirectory = 0
+    $permissions = foreach ($perm in @($role.PSObject.Properties['rolePermissions']?.Value)) {
+        if ($null -eq $perm) { continue }
+        $cond = $perm.PSObject.Properties['condition']?.Value
+        $actions = foreach ($a in @($perm.PSObject.Properties['allowedResourceActions']?.Value | Where-Object { $_ } | Sort-Object)) {
+            $ns = Get-Namespace $a
+            $d = $details[([string]$a).ToLowerInvariant()]
+            if (-not $d) {
+                $undescribed.Add([string]$a)
+                if ($ns -eq $directoryNs) { $undescribedDirectory++ }
+            }
+            [ordered]@{
+                name         = [string]$a
+                namespace    = $ns
+                described    = [bool]$d
+                description  = if ($d) { [string]$d.description } else { $null }
+                isPrivileged = if ($d -and $ns -eq $directoryNs) { $d.isPrivileged } else { $null }
+            }
+        }
+        [ordered]@{ condition = if ($cond) { [string]$cond } else { $null }; actions = @($actions) }
+    }
+
+    $sensitive = @(Get-SensitiveActions $role)
+    $flag = [bool]($role.PSObject.Properties['isPrivileged']?.Value)
+    $check = if (-not $directoryAvailable) {
+        [ordered]@{ status = 'unknown'; reason = "No resource-action data for $directoryNs." }
+    }
+    elseif ($flag -and $sensitive.Count -gt 0) { [ordered]@{ status = 'consistent'; reason = "Privileged, and $($sensitive.Count) of its actions are flagged sensitive." } }
+    elseif (-not $flag -and $sensitive.Count -eq 0) {
+        if ($undescribedDirectory -gt 0) { [ordered]@{ status = 'unknown'; reason = "Not privileged; $undescribedDirectory $directoryNs actions have no data, so a sensitive one cannot be ruled out." } }
+        else { [ordered]@{ status = 'consistent'; reason = 'Not privileged, and none of its actions is flagged sensitive.' } }
+    }
+    elseif ($flag) {
+        if ($undescribedDirectory -gt 0) { [ordered]@{ status = 'unknown'; reason = "Privileged, but no flagged action found and $undescribedDirectory $directoryNs actions have no data." } }
+        else { [ordered]@{ status = 'role-flag-without-sensitive-action'; reason = 'Privileged, but none of its actions is flagged sensitive.' } }
+    }
+    else { [ordered]@{ status = 'sensitive-action-without-role-flag'; reason = "Not privileged, but $($sensitive.Count) of its actions are flagged sensitive." } }
+
+    $inherits = foreach ($ref in @($role.PSObject.Properties['inheritsPermissionsFrom']?.Value | Where-Object { $_ })) {
+        $rid = if ($ref -is [string]) { $ref } else { [string]($ref.PSObject.Properties['id']?.Value ?? $ref.PSObject.Properties['templateId']?.Value) }
+        $rid = $rid.ToLowerInvariant()
+        $parent = $roles[$rid]
+        [ordered]@{
+            templateId        = $rid
+            displayName       = if ($parent) { [string]$parent.displayName } else { $null }
+            found             = [bool]$parent
+            sensitiveActions  = if ($parent) { @(Get-SensitiveActions $parent) } else { @() }
+        }
+    }
+
+    [pscustomobject][ordered]@{
+        templateId         = $id
+        displayName        = [string]$role.displayName
+        isPrivileged       = $flag
+        privilegedBecause  = $sensitive
+        privilegeCheck     = $check
+        permissions        = @($permissions)
+        inheritsFrom       = @($inherits)
+        undescribedActions = @($undescribed | Sort-Object -Unique)
+        resourceActions    = [ordered]@{ provided = [bool]$ResourceActionsDir; directoryStatus = if ($nsStatus.ContainsKey($directoryNs)) { $nsStatus[$directoryNs] } else { 'missing' } }
+        definition         = $role
+    }
+}
