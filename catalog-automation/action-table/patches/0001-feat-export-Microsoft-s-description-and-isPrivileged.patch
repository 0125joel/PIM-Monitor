     $inputs = foreach ($r in $picked) {
         $file = Join-Path $SnapshotDir "$(Get-Id $r).json"
         if (-not (Test-Path $file)) { throw "No snapshot file for $($r.displayName) ($($r.templateId))." }
         $snap = Get-Content -Raw -Path $file | ConvertFrom-Json
         $actions = @($snap.rolePermissions | ForEach-Object { $_.allowedResourceActions } | Where-Object { $_ } | Sort-Object -Unique)
-        [ordered]@{
+        $entry = [ordered]@{
             templateId             = [string]$r.templateId
             displayName            = [string]$r.displayName
             description            = [string]($snap.PSObject.Properties['description']?.Value ?? '')
             isPrivileged           = [bool]$snap.isPrivileged
             allowedResourceActions = $actions
         }
+        if ($ResourceActionsDir) {
+            $found = @($actions | ForEach-Object { $details[([string]$_).ToLowerInvariant()] } | Where-Object { $_ })
+            $sampleActions += $actions.Count; $sampleDescribed += $found.Count
+            $entry.actionDetails = $found
+        }
+        $entry
     }
     $key = foreach ($r in $picked) {
         [ordered]@{ templateId = [string]$r.templateId; displayName = [string]$r.displayName; plane = [string]$r.plane; securityLevel = [string]$r.securityLevel; isPrivileged = [bool]$r.isPrivileged }
@@ -176,6 +199,11 @@ if ($Mode -eq 'Prepare') {
         catalogSha256   = Get-Sha256 $CatalogPath
         rubricSha256    = if ($RubricPath) { Get-Sha256 $RubricPath } else { $null }
         snapshotSha256  = [Convert]::ToHexString($snapHash).ToLowerInvariant()
+        resourceActionsSha256 = if ($ResourceActionsDir) {
+            $h = [System.Security.Cryptography.SHA256]::HashData([System.Text.Encoding]::UTF8.GetBytes((($detailFiles | ForEach-Object { "$($_.Name):$(Get-Sha256 $_.FullName)" }) -join "`n")))
+            [Convert]::ToHexString($h).ToLowerInvariant()
+        } else { $null }
+        actionCoverage  = if ($ResourceActionsDir) { [ordered]@{ actions = $sampleActions; described = $sampleDescribed } } else { $null }
         sampleTemplateIds = $sampleIds
     }
 
diff --git a/tests/RoleSnapshot.Tests.ps1 b/tests/RoleSnapshot.Tests.ps1
index 0916d7f..4e4f877 100644
--- a/tests/RoleSnapshot.Tests.ps1
+++ b/tests/RoleSnapshot.Tests.ps1
@@ -83,6 +83,80 @@ Describe 'Export-RoleDefinitions' {
     }
 }
 
+Describe 'Export-ResourceActions' {
+    BeforeAll {
+        $script:exportActions = Join-Path $script:repoRoot 'catalog-automation/Export-ResourceActions.ps1'
+        $script:raSnap = Join-Path $TestDrive 'ra-snap'
+        Write-Snapshot $script:raSnap @(
+            (New-RoleDef 'aaaaaaaa-0000-0000-0000-000000000001' 'One' -Actions @('microsoft.directory/users/password/update', 'microsoft.office365.supportTickets/allEntities/allTasks')),
+            (New-RoleDef 'aaaaaaaa-0000-0000-0000-000000000002' 'Two' -Actions @('microsoft.directory/users/standard/read'))
+        )
+        $script:raGood = {
+            param($ns)
+            switch ($ns) {
+                'microsoft.directory' { @(
+                        [pscustomobject]@{ name = 'microsoft.directory/users/standard/read'; description = 'Read users'; isPrivileged = $false },
+                        [pscustomobject]@{ name = 'microsoft.directory/users/password/update'; description = 'Reset passwords'; isPrivileged = $true }) }
+                'microsoft.office365.supportTickets' { @([pscustomobject]@{ name = 'microsoft.office365.supportTickets/allEntities/allTasks'; description = 'Manage tickets'; isPrivileged = $false }) }
+            }
+        }
+    }
+
+    It 'writes one sorted file per namespace the roles use, and an index with coverage' {
+        $out = Join-Path $TestDrive 'ra-out'
+        & $script:exportActions -RoleDefinitionsDir $script:raSnap -OutputPath $out -Fetch $script:raGood | Out-Null
+        @(Get-ChildItem $out -Filter '*.json').Name | Sort-Object | Should -Be @('index.json', 'microsoft.directory.json', 'microsoft.office365.supportTickets.json')
+        $dir = Get-Content -Raw (Join-Path $out 'microsoft.directory.json') | ConvertFrom-Json
+        @($dir.actions.name) | Should -Be @('microsoft.directory/users/password/update', 'microsoft.directory/users/standard/read')
+        ($dir.actions | Where-Object name -like '*password*').isPrivileged | Should -BeTrue
+        $idx = Get-Content -Raw (Join-Path $out 'index.json') | ConvertFrom-Json
+        $idx.roleActions | Should -Be 3
+        $idx.described | Should -Be 3
+        $idx.namespaces.'microsoft.directory'.status | Should -Be 'ok'
+    }
+
+    It 'keeps the previous file of a namespace that fails, and says so in the index' {
+        $out = Join-Path $TestDrive 'ra-out'
+        $before = Get-Content -Raw (Join-Path $out 'microsoft.directory.json')
+        $bad = { param($ns) if ($ns -eq 'microsoft.directory') { throw 'HTTP 503' } else { & $script:raGood $ns } }
+        & $script:exportActions -RoleDefinitionsDir $script:raSnap -OutputPath $out -Fetch $bad | Out-Null
+        Get-Content -Raw (Join-Path $out 'microsoft.directory.json') | Should -Be $before
+        $idx = Get-Content -Raw (Join-Path $out 'index.json') | ConvertFrom-Json
+        $idx.namespaces.'microsoft.directory'.status | Should -Be 'failed-kept-previous'
+        $idx.namespaces.'microsoft.directory'.error | Should -BeLike '*503*'
+    }
+
+    It 'treats an empty response as a failure, not as a namespace without actions' {
+        $out = Join-Path $TestDrive 'ra-empty'
+        & $script:exportActions -RoleDefinitionsDir $script:raSnap -OutputPath $out -Fetch { param($ns) @() } | Out-Null
+        Test-Path (Join-Path $out 'microsoft.directory.json') | Should -BeFalse
+        $idx = Get-Content -Raw (Join-Path $out 'index.json') | ConvertFrom-Json
+        $idx.namespaces.'microsoft.directory'.status | Should -Be 'failed'
+        $idx.described | Should -Be 0
+        @($idx.undescribed).Count | Should -Be 3
+    }
+
+    It 'gives the backtest input the description and flag of each action' {
+        $out = Join-Path $TestDrive 'ra-out2'
+        & $script:exportActions -RoleDefinitionsDir $script:raSnap -OutputPath $out -Fetch $script:raGood | Out-Null
+        $cat = Join-Path $TestDrive 'ra-cat.json'
+        @{ roleCount = 2; roles = @(
+                @{ templateId = 'aaaaaaaa-0000-0000-0000-000000000001'; displayName = 'One'; plane = 'Control'; securityLevel = 'Specialized'; isPrivileged = $false },
+                @{ templateId = 'aaaaaaaa-0000-0000-0000-000000000002'; displayName = 'Two'; plane = 'Control'; securityLevel = 'Enterprise'; isPrivileged = $false }) } | ConvertTo-Json -Depth 5 | Set-Content $cat
+        $bt = Join-Path $script:repoRoot 'catalog-automation/Invoke-CatalogBacktest.ps1'
+        $o = Join-Path $TestDrive 'ra-bt'
+        & $bt -Mode Prepare -CatalogPath $cat -SnapshotDir $script:raSnap -ResourceActionsDir $out -OutDir $o -Count 2 | Out-Null
+        $in = Get-Content -Raw (Join-Path $o 'input.json') | ConvertFrom-Json
+        $one = $in | Where-Object displayName -eq 'One'
+        @($one.actionDetails).Count | Should -Be 2
+        ($one.actionDetails | Where-Object name -like '*password*').description | Should -Be 'Reset passwords'
+        $m = Get-Content -Raw (Join-Path $o 'meta.json') | ConvertFrom-Json
+        $m.actionCoverage.actions | Should -Be 3
+        $m.actionCoverage.described | Should -Be 3
+        $m.resourceActionsSha256 | Should -Match '^[0-9a-f]{64}$'
+    }
+}
