From d3d830078a596c0fabb707bbaa95cb8b293a93c0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 16 Nov 2026 12:24:23 +0000
Subject: [PATCH 4/5] fix: report vanished roles, null the per-action flag
 outside microsoft.directory, stop the export only on core properties

- Compare: vanishedRoles lists roles that were in the base snapshot, are gone from head and were
  never in the catalog; they count towards needsReview (schema v2 updated).
- Export-ResourceActions: Microsoft applies isPrivileged only to the microsoft.directory namespace,
  so it is null for every other namespace instead of a misleading false.
- Export-RoleDefinitions: only a lost core property (templateId, id, displayName, isBuiltIn,
  isPrivileged, rolePermissions) stops the export. Any other lost property, such as resourceScopes,
  which Microsoft documents as deprecated soon, is written, recorded as lostProperties, and reaches
  review through the comparison.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JQVkCwrr6JcCnvT3VV2czd
---
 catalog-automation/Compare-RoleSnapshots.ps1  |  15 +-
 catalog-automation/Export-ResourceActions.ps1 |   7 +-
 catalog-automation/Export-RoleDefinitions.ps1 |  21 +-
 catalog-automation/Invoke-CatalogBacktest.ps1 |   2 +-
 schemas/entra-role-export-report-v2.json      | 324 +++++++++++++++---
 tests/RoleSnapshot.Tests.ps1                  |  32 +-
 6 files changed, 336 insertions(+), 65 deletions(-)

diff --git a/catalog-automation/Compare-RoleSnapshots.ps1 b/catalog-automation/Compare-RoleSnapshots.ps1
index fe8e1d0..dd99872 100644
--- a/catalog-automation/Compare-RoleSnapshots.ps1
+++ b/catalog-automation/Compare-RoleSnapshots.ps1
@@ -8,6 +8,7 @@
 
       newRoles      roles in the head snapshot that the catalog does not list
       removedRoles  roles the catalog lists that the head snapshot no longer has
+      vanishedRoles roles in the base snapshot that head no longer has and the catalog never listed
       changedRoles  every role present in base and head whose definition differs, field by field:
                       addedPermissions / removedPermissions  permissions as (action, condition) pairs;
                                                              a condition change shows as one removed
@@ -206,6 +207,13 @@ $removedRoles = foreach ($id in ($catalogById.Keys | Sort-Object)) {
     }
 }
 
+# Roles that were in the base snapshot and are gone from head, but were never in the catalog (they
+# appeared and disappeared between two reviews). removedRoles does not cover them: it is catalog-based.
+$vanishedRoles = foreach ($id in ($base.Keys | Sort-Object)) {
+    if ($head.ContainsKey($id) -or $catalogById.ContainsKey($id)) { continue }
+    [ordered]@{ templateId = $id; displayName = [string]$base[$id].displayName }
+}
+
 # Own changes of every role present in both snapshots. Nothing is skipped.
 $own = @{}
 foreach ($id in $head.Keys) {
@@ -280,6 +288,7 @@ $changedRoles = foreach ($id in ($head.Keys | Sort-Object)) {
 
 $newRoles = @($newRoles)
 $removedRoles = @($removedRoles)
+$vanishedRoles = @($vanishedRoles)
 $changedRoles = @($changedRoles)
 
 $report = [ordered]@{
@@ -290,12 +299,14 @@ $report = [ordered]@{
     summary       = [ordered]@{
         newRoles        = $newRoles.Count
         removedRoles    = $removedRoles.Count
+        vanishedRoles   = $vanishedRoles.Count
         changedRoles    = $changedRoles.Count
         readOnlyChanges = $readOnlyChanges
-        needsReview     = ($newRoles.Count + $removedRoles.Count + $changedRoles.Count) -gt 0
+        needsReview     = ($newRoles.Count + $removedRoles.Count + $vanishedRoles.Count + $changedRoles.Count) -gt 0
     }
     newRoles      = $newRoles
     removedRoles  = $removedRoles
+    vanishedRoles = $vanishedRoles
     changedRoles  = $changedRoles
 }
 
@@ -303,4 +314,4 @@ $json = ($report | ConvertTo-Json -Depth 20) -replace "`r`n", "`n"
 $outDir = Split-Path -Parent ([System.IO.Path]::GetFullPath($OutputPath))
 New-Item -ItemType Directory -Force -Path $outDir | Out-Null
 [System.IO.File]::WriteAllText($OutputPath, $json + "`n", [System.Text.UTF8Encoding]::new($false))
-Write-Host "Report: $($newRoles.Count) new, $($removedRoles.Count) removed, $($changedRoles.Count) changed, $readOnlyChanges of them read-only"
+Write-Host "Report: $($newRoles.Count) new, $($removedRoles.Count) removed, $($vanishedRoles.Count) vanished, $($changedRoles.Count) changed, $readOnlyChanges of them read-only"
diff --git a/catalog-automation/Export-ResourceActions.ps1 b/catalog-automation/Export-ResourceActions.ps1
index fae8454..00af120 100644
--- a/catalog-automation/Export-ResourceActions.ps1
+++ b/catalog-automation/Export-ResourceActions.ps1
@@ -7,7 +7,8 @@
     A role definition lists its actions (rolePermissions[].allowedResourceActions) but says nothing
     about them. Graph describes each action per namespace:
     GET /beta/roleManagement/directory/resourceNamespaces/{namespace}/resourceActions
-    with name, description and isPrivileged (Microsoft's flag for a privileged permission). Like the
+    with name, description and isPrivileged (Microsoft's flag for a sensitive action; it applies only to
+    the microsoft.directory namespace, so it is null for every other namespace). Like the
     role definitions, this is the same in every tenant and holds no tenant data.
 
     The namespaces are taken from the actions in the role snapshot, so only what the roles use is
@@ -78,7 +79,9 @@ foreach ($ns in $namespaces) {
                 [ordered]@{
                     name         = [string]$_.name
                     description  = [string]($_.PSObject.Properties['description']?.Value ?? '')
-                    isPrivileged = [bool]($_.PSObject.Properties['isPrivileged']?.Value)
+                    # Microsoft: isPrivileged "applies only for actions in the microsoft.directory
+                    # resource namespace". Elsewhere it is not a verdict, so it is null, not false.
+                    isPrivileged = if ($ns -eq 'microsoft.directory') { [bool]($_.PSObject.Properties['isPrivileged']?.Value) } else { $null }
                 }
             } | Sort-Object { $_.name })
         Write-JsonFile @{ namespace = $ns; actions = $actions } $file
