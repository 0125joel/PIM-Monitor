+function Get-PairsOnlyIn {
+    # Pairs that are in $To and not in $From, sorted by key.
+    param([hashtable] $From, [hashtable] $To)
+    $out = @(foreach ($key in ($To.Keys | Where-Object { -not $From.ContainsKey($_) } | Sort-Object)) {
+            [ordered]@{ action = $To[$key].action; condition = $To[$key].condition }
+        })
